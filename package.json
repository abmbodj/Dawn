{
  "name": "dawn",
  "version": "0.1.0",
  "description": "Dawn — a token-frugal AI coding agent for the terminal",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "dawn": "./index.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dawn": "bun run index.ts",
    "setup": "bun install && bun link",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "preflight": "bun test && bun run typecheck && bun run check",
    "format": "biome format --write .",
    "bench": "bun run bench/run.ts",
    "bench:report": "bun run bench/report.ts"
  },
  "dependencies": {
    "@dawn/core": "workspace:*",
    "@dawn/tui": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
