{
  "name": "dawn",
  "version": "0.1.0",
  "description": "Dawn — a token-frugal AI coding agent for the terminal",
  "type": "module",
  "private": true,
  "bin": {
    "dawn": "./index.ts"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "dawn": "bun run index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@dawn/core": "workspace:*",
    "@dawn/tui": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
